# ==========================================
# VideshaMitra — local environment example
# Copy to .env and fill in. Never commit .env.
# ==========================================

# --- Core service -----------------------------------------------------
# development | test | staging | production. Defaults to production if unset.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# --- Database (Supabase local Postgres) -------------------------------
# Host commands (uvicorn, migrations, seed):
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Containers (docker compose); defaults to host.docker.internal when unset:
DOCKER_DATABASE_URL=
DOCKER_SUPABASE_INTERNAL_URL=

# --- Supabase ---------------------------------------------------------
SUPABASE_URL=http://localhost:54321
# Server-to-server copy; inside Docker set http://host.docker.internal:54321.
SUPABASE_INTERNAL_URL=
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Local Supabase CLI default. Rejected outside development/test.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Optional; defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
JWT_AUDIENCE=authenticated
JWT_ISSUER=http://localhost:54321/auth/v1

# --- Redis / events ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Required, min 32 chars. Generate with: openssl rand -hex 32
INTERNAL_JWT_SECRET=
INTERNAL_JWT_ISSUER=core-api
INTERNAL_JWT_AUDIENCE=core-api
INTERNAL_ALLOWED_ISSUERS=["ai-service","notification-service"]
INTERNAL_JWT_TTL_SECONDS=300

# --- Internal services (host runs only; Compose uses service DNS) ------
AI_SERVICE_URL=http://localhost:8010
NOTIFICATION_SERVICE_URL=http://localhost:8020

# --- Documents --------------------------------------------------------
DOCUMENTS_BUCKET=documents
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=50
SIGNED_URL_TTL_SECONDS=300

# --- Domain workers ---------------------------------------------------
CHECKIN_GRACE_HOURS=72
STALE_PROCESSING_MINUTES=15
MAX_VERIFICATION_RETRIES=3
AGENCY_MONITOR_INTERVAL_SECONDS=3600
CHECKIN_SCHEDULER_INTERVAL_SECONDS=60

# --- SLBFE ------------------------------------------------------------
SLBFE_SOURCE_URL=
SLBFE_API_KEY=

# --- WhatsApp webhook -------------------------------------------------
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Auth limits ------------------------------------------------------
OTP_RATE_LIMIT_PER_10_MIN=5
LOGIN_RATE_LIMIT_PER_10_MIN=10

# --- Local auth fallback (development/test only) ----------------------
# Lets /auth/otp/verify accept this code for existing or new worker accounts
# (never staff). Startup fails if set outside development/test.
AUTH_DEV_OTP=

# --- Frontends --------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
