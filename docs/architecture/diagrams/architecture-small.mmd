    classDef ai fill:#f3e5f5,stroke:#7b1fa2,color:#4a148c
    classDef notify fill:#e0f7fa,stroke:#00838f,color:#006064
    classDef data fill:#eceff1,stroke:#455a64,color:#263238
    classDef ext fill:#fce4ec,stroke:#ad1457,color:#880e4f
