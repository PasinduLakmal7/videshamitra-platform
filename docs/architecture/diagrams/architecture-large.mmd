%%{init: {"flowchart": {"nodeSpacing": 24, "rankSpacing": 80}, "themeVariables": {"fontSize": "14px"}}}%%
flowchart LR
    subgraph Clients["Clients and channels"]
        direction TB
        Mobile["Worker mobile app<br/>Flutter - separate repo<br/>offline cache + FCM push"]
        Web["Worker web portal<br/>React + Vite + TS - :5173"]
        Admin["Caseworker / admin portal<br/>React + Vite + TS - :5174"]
        WAUser["WhatsApp worker"]
    end

    Kong["Kong 3.9 DB-less gateway - :8000<br/>only public port - CORS<br/>600 req/min - 30 MB cap"]

    subgraph Core["core-api + core-api-worker"]
        direction TB
        subgraph CoreAPI["core-api - FastAPI - :8000"]
            direction TB
            PublicAPI["Public API /api/v1<br/>auth - users - agencies - verification<br/>documents - migration - check-ins<br/>complaints - notifications - admin<br/>chat - webhooks"]
            InternalAPI["Internal API /internal/v1<br/>document bytes - agency history<br/>verification context - audit"]
            Domain["Domain services + repositories<br/>Supabase JWT + role guards<br/>idempotency - state machines - audit"]
            Outbox["Transactional outbox<br/>domain write + event insert"]
        end
        Worker["core-api-worker<br/>outbox relay - AI result consumer<br/>check-in scheduler - agency watchdog<br/>cleanup + stale verification recovery"]
    end

    subgraph Streams["Redis 7 - streams, consumer groups, dedupe"]
        direction TB
        S1["vm:ai:requests<br/>verification.requested"]
        S2["vm:ai:results<br/>verification.completed / failed"]
        S3["vm:notifications:requests<br/>notification.requested"]
        S4["vm:notifications:results<br/>notification.delivery.updated"]
        DLQ["consumer groups +<br/>dead-letter streams"]
    end

    subgraph AIService["ai-service - FastAPI + LangGraph - :8010"]
        direction TB
        AIGateway["Internal API<br/>chat SSE - speech - analyses<br/>WhatsApp - health"]
        Supervisor["LangGraph Supervisor<br/>intent - routing - triage"]
        Agents["Document and Contract<br/>Recruitment Verification<br/>Migration Guardian<br/>Case Support"]
        AIInfra["OCR + extraction - Gemini adapter<br/>guardrails - traces - checkpoints"]
    end

    subgraph NotificationService["notification-service - FastAPI - :8020 + worker"]
        direction TB
        NotifAPI["Internal API<br/>devices - preferences"]
        NotifWorker["Stream consumer + delivery worker<br/>dedupe - quiet hours - retries<br/>delivery status"]
        Providers["FCM HTTP v1 - WhatsApp Cloud API<br/>stub provider"]
    end

    subgraph Data["Data layer - no public ports"]
        direction TB
        PG[("Supabase Postgres<br/>core - ai - notification schemas<br/>auth - storage metadata")]
        Storage[("Supabase Storage<br/>private documents bucket<br/>short-lived signed URLs")]
    end

    subgraph External["External providers"]
        direction TB
        SupaAuth["Supabase Auth<br/>email + phone OTP - JWTs"]
        SLBFE["SLBFE agency source<br/>CSV / JSON import"]
        Gemini["Google Gemini<br/>LLM - vision - audio"]
        FCM["Firebase Cloud Messaging"]
        Meta["WhatsApp Cloud API"]
        SMS["SMS provider - planned"]
    end

    PublicAPI ~~~ InternalAPI ~~~ Domain ~~~ Outbox
    AIGateway ~~~ Supervisor ~~~ Agents ~~~ AIInfra
    NotifAPI ~~~ NotifWorker ~~~ Providers
    S1 ~~~ S2 ~~~ S3 ~~~ S4 ~~~ DLQ
    PG ~~~ Storage
    SupaAuth ~~~ SLBFE ~~~ Gemini ~~~ FCM ~~~ Meta ~~~ SMS

    Mobile -->|HTTPS| Kong
    Web -->|HTTPS| Kong
    Admin -->|HTTPS| Kong
    WAUser -->|webhook via Meta| Kong

    Kong -->|/api/v1 + /health| CoreAPI
    CoreAPI -->|sync - service JWT<br/>chat + speech| AIService
    CoreAPI -->|sync - service JWT<br/>devices + preferences| NotificationService
    AIService -->|service JWT<br/>documents + history| CoreAPI

    Outbox -.->|outbox relay publishes| Streams
    Streams -->|consume| AIService
    AIService -->|publish results| Streams
    Streams -.->|consume results| Worker
    Streams -->|consume| NotificationService
    Streams -.->|optional status| CoreAPI

    Core -->|SQL + blobs + signed URLs| Data
    AIService -->|ai schema| Data
    NotificationService -->|notification schema| Data
    Core -->|Supabase Auth + SLBFE| External
    AIService -->|LLM + vision + audio| External
    NotificationService -->|FCM + WhatsApp + SMS| External

